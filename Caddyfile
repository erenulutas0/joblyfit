# Caddy — reverse proxy + otomatik HTTPS (D-049).
# {$DOMAIN} ve {$SITE_DOMAIN} docker-compose'daki .env.prod'dan gelir.
# Caddy, Let's Encrypt sertifikasını kendi alır ve yeniler — elle iş yok.

# --- Uygulama: app.joblyfit.com ---
{$DOMAIN} {
	encode zstd gzip

	# Uygulama sayfası `noindex` işaretli (bkz. web/app.html): içeriği istemcide
	# oluşuyor, bota boş kabuk görünüyor. Taramayı burada ENGELLEMİYORUZ —
	# engellenirse Google `noindex` etiketini de göremez ve sayfa dizinde kalır.
	# Uygulama Python'dan servis edildiği için robots.txt 404 dönüyordu.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `User-agent: *
Allow: /
Sitemap: https://joblyfit.com/sitemap.xml
` 200
	}

	reverse_proxy app:8137
}

# --- Tanıtım sayfası: joblyfit.com (+ www) --- D-066
#
# Kök domain bugüne kadar HİÇ yapılandırılmamıştı: joblyfit.com'a giren
# kullanıcı ürünü tanımadan bir hataya düşüyordu.
#
# Statik dosya Caddy'den servis edilir; pazarlama trafiği Python'a hiç uğramaz.
# Yalnızca `web/site/` mount edilir — `web/` kökünü açmak app.html ve
# index.html'i de kök domainden erişilebilir kılardı.
#
# `/api/health` ve `/api/feed` proxy'lenir: sayfa canlı sayaçlarını AYNI
# origin'den okur, böylece CORS gerekmez. Elle yazılmış bir sayı kaçınılmaz
# olarak bayatlar ve ürünün "yalnızca ölçtüğümüzü söyleriz" iddiasıyla
# çelişirdi.
{$SITE_DOMAIN:joblyfit.com}, www.{$SITE_DOMAIN:joblyfit.com} {
	encode zstd gzip

	# www → apex: tek kanonik adres kalsın (SEO'da içerik ikizi olmasın).
	@www host www.{$SITE_DOMAIN:joblyfit.com}
	redir @www https://{$SITE_DOMAIN:joblyfit.com}{uri} permanent

	handle /api/health {
		reverse_proxy app:8137
	}
	handle /api/feed {
		reverse_proxy app:8137
	}
	handle {
		root * /srv/site
		file_server
	}

	# Bilinmeyen yol → GERÇEK 404. İlk sürümde burada `try_files {path}
	# /index.html` vardı: bu bir SPA kalıbı, oysa tanıtım sayfası SPA değil, tek
	# statik sayfa. Sonuç "yumuşak 404" idi — joblyfit.com/olmayan-sayfa HTTP 200
	# + ana sayfa döndürüyordu. Arama motoru bunu içerik ikizi sayıp dizinden
	# düşürür, kullanıcı da yanlış adreste olduğunu hiç anlamaz.
	#
	# `status {err.status_code}` ŞART: onsuz Caddy 404.html'i 200 ile servis eder
	# ve hata yine gizlenir — düzeltmenin tamamı bu satırda.
	handle_errors {
		root * /srv/site
		rewrite * /404.html
		file_server {
			status {err.status_code}
		}
	}
}
