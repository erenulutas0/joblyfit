# Yerel sırlar — bu dosyayı .env.local olarak kopyalayıp doldur.
# .env.local .gitignore'dadır: buradaki değerler ASLA commit'lenmez.
#
# ÖNEMLİ: Bu dosyayı PROJE KÖKÜNDE oluştur (system32'de değil). Windows
# PowerShell'de BOM sorununu önlemek için tercihen düz bir editörle yaz.
#
# Jooble API anahtarı (ücretsiz).
#   - Türkiye ilanları için: tr.jooble.org/api/about'tan kayıt ol (Website ister).
#   - Uluslararası/ABD için:  jooble.org/api/about
# Anahtar hangi ülke sitesinde alındıysa host da o olmalı (D-041).
ISUYGUN_JOOBLE_KEY=

# Jooble ülke sitesi. Varsayılan tr.jooble.org (Türkiye hedefi).
# Uluslararası anahtar kullanıyorsan: jooble.org
ISUYGUN_JOOBLE_HOST=tr.jooble.org

# Jooble konum sorgusu. tr.jooble.org için "Türkiye"; jooble.org için "Turkey".
ISUYGUN_JOOBLE_LOCATION=Türkiye
